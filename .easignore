# EAS Build Ignore
# This file is used to ignore files when uploading your project to EAS.
# It helps reduce upload time and prevents unnecessary files from being sent.

# Dependencies (EAS handles these)
node_modules/

# Native build artifacts
android/build/
android/.gradle/
android/app/build/
ios/build/
ios/Pods/
ios/DerivedData/

# Expo artifacts
.expo/
dist/
web-build/

# Metro
.metro-health-check*
.metro-virtual/

# Version control
.git/

# Debug and Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# IDEs
.vscode/
.idea/

# Environment
.env*.local

# Caches
caches/
.cache/

# Examples
app-example/
